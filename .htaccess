# ---------------------------------------------------------------------
# Apache configuration for serving the iEnergy Portal from cPanel.
#
# Inert on GitHub Pages, which ignores .htaccess entirely, so this can
# sit here before the move and start working the moment the files are
# served by Apache instead.
# ---------------------------------------------------------------------

# --- HTTPS, always -----------------------------------------------------
# On, because the certificate is confirmed: Let's Encrypt, issued
# 20 Oct 2026, covering portal.ienergyegypt.com and the www form, both
# verifying as trusted. The reason to leave this off was the risk of
# redirecting to an address with no certificate, and that risk is gone.
#
# cPanel has its own Force HTTPS Redirect toggle for the same job. It
# would not switch on while AutoSSL's bookkeeping lagged behind the
# certificate it had already issued, so this does it instead. Turning
# the toggle on later as well is harmless -- the redirect simply happens
# a layer earlier.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# --- No directory listings ---------------------------------------------
# An empty or part-deployed folder currently answers with Index of /,
# which lists what is inside it. A site should not hand out its own file
# listing, and during a deploy that listing is a half-uploaded one.
Options -Indexes

<IfModule mod_headers.c>
  # --- HTML is never cached --------------------------------------------
  # This is the rule GitHub Pages would not let us set. It sent HTML with
  # max-age=600, so for ten minutes after every deploy a returning
  # visitor was served the previous page out of their own cache -- which
  # is what kept sending people back to the portal after the tracker was
  # fixed. Revalidating every time costs one small request and ends that
  # whole class of problem.
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # --- Hashed build output is cached forever ---------------------------
  # Vite puts a content hash in these filenames, so a changed file is a
  # different URL. They can be cached hard and for a long time.
  <FilesMatch "-[A-Za-z0-9_-]{8,}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # --- The site's own scripts and styles ------------------------------
  # These are versioned by query string -- auth.js?v=8 -- and FilesMatch
  # matches the filename, which has no query in it. So they matched
  # nothing above and went out with no Cache-Control whatsoever, leaving
  # the browser to guess from Last-Modified. That guess holds until a
  # deploy, after which the files look newly written, the guessed
  # lifetime collapses to nearly nothing, and every navigation
  # revalidates every asset against a server on another continent.
  #
  # A changed file gets a new ?v=, which is a new URL, so caching the
  # old one hard is safe. Bump the version when you change the file --
  # that is what makes this correct rather than merely fast.
  <FilesMatch "^(auth|theme|dashboard|responsive|home|contacts-list|employee-database|salary-calculator)\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # The vendored Supabase bundle carries its version in the filename.
  <FilesMatch "^supabase-js-[0-9.]+\.js$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # --- Everything else: a short cache, revalidated ---------------------
  <FilesMatch "\.(png|jpg|jpeg|svg|ico|webp|woff2?)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>

  # --- Modest hardening -------------------------------------------------
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
</IfModule>

<IfModule mod_deflate.c>
  # text/javascript is the one that matters: that is what this server
  # actually labels .js files as, and it was missing, so every script
  # went out uncompressed while the stylesheets were compressed fine.
  # The three shared ones alone were 43,660 B instead of 13,676 B.
  AddOutputFilterByType DEFLATE text/html text/css text/javascript \
    application/javascript application/json image/svg+xml text/plain
</IfModule>

# --- Do not serve what is not meant to be served -----------------------
<FilesMatch "^\.(git|env)">
  Require all denied
</FilesMatch>

# The apps route on the hash, so no rewrite rules are needed for deep
# links: the server only ever sees the directory's index.html.
DirectoryIndex index.html

# --- Spreadsheets and documents are not browsable --------------------
# A file served from the web is served to anyone who knows its address.
# The portal's sign-in is JavaScript on a page, and a direct request for
# a file never runs it -- so a spreadsheet of salaries sitting in a
# folder was downloadable by anyone who guessed the URL.
#
# The salaries file is gone. This stops the next one being published by
# accident: anything in salary-query that is not the page itself is
# refused outright.
<FilesMatch "\.(xlsx|xls|csv)$">
  Require all denied
</FilesMatch>
