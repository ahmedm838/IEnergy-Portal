# Copy to .env.local and fill in from your Supabase project:
#   Project Settings -> API
#
# The anon key is a publishable key designed to ship in a browser bundle.
# Row Level Security is what protects the data, so keep the policies in
# supabase/03_rls.sql applied and never put the service_role key in here.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
